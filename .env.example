# Verbindungsdaten für die Datenbank, die das Aufgaben-Notebook verwendet.
# Diese Datei in eine neue .env-Datei kopieren und die echten Werte eintragen. .env nie per Commit ins Repo aufnehmen.
# Die Notebooks bauen die Verbindungs-URL automatisch aus diesen Feldern.

DATABASE=<your-database-name>
USER_DB=<your-username>
PASSWORD=<your-password>
HOST=<your-host>
PORT=5432
